# ==============================================================================
# ENVIRONMENT CONFIGURATION FOR TWO-PARTNER PRIVATE MESSENGER
# Copy this file to .env and customize values for your deployment
# NEVER commit your actual .env file or production secrets to Git!
# ==============================================================================

# Application Profile (dev | prod)
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=chatapp_db
DB_USER=chatapp_user
DB_PASSWORD=chatapp_secure_dev_pass_2026

# JWT & Device Session Security
# Generate 512-bit Base64 key: openssl rand -base64 64
JWT_SECRET=4Z03kI3/YpA2W5Q6kFv7eJ8lM9nO0pQ1rS2tU3vW4xY5zA6bC7dE8fG9hI0jK1lM2nO3pQ4rS5tU6vW7xY8z9A==
JWT_EXPIRATION_MS=86400000
REFRESH_TOKEN_EXPIRATION_MS=2592000000

# 6-Digit Pairing Configuration (Strict Security)
PAIRING_CODE_EXPIRATION_SECONDS=300
PAIRING_CODE_MAX_ATTEMPTS=5
PAIRING_RATE_LIMIT_PER_MINUTE=10

# Media & Attachment Storage
MEDIA_STORAGE_PATH=./uploads/media
MAX_FILE_SIZE_BYTES=52428800

# Firebase Cloud Messaging (FCM)
# Provide path to downloaded service account JSON from Firebase Console
FIREBASE_CREDENTIALS_PATH=./config/firebase-service-account.json

# WebRTC STUN & TURN Configuration
STUN_SERVER_URL=stun:stun.l.google.com:19302
TURN_SERVER_URL=turn:localhost:3478
TURN_SERVER_REALM=chatapp.local
TURN_SHARED_SECRET=coturn_shared_secret_secure_key_2026
TURN_CREDENTIAL_TTL_SECONDS=86400

# Coturn Docker Ports
COTURN_PORT=3478
COTURN_MIN_PORT=49152
COTURN_MAX_PORT=49200
